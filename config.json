{
  "reciter": {
    "name_ar": "الشيخ محمد صديق المنشاوي",
    "recitations": {
      "mujawwad": {
        "id": 8,
        "style_ar": "مجوّد"
      },
      "murattal": {
        "id": 9,
        "style_ar": "مرتّل"
      }
    },
    "default_style": "murattal"
  },
  "clip": {
    "min_seconds": 20,
    "max_seconds": 40,
    "prepend_basmala": true,
    "_note": "Shorter clips (20-40 s) are watched to the end and replayed more often, which is what TikTok rewards."
  },
  "short_surahs": {
    "_note": "Al-Fatiha and any surah whose whole murattal recitation fits in max_seconds are posted as ONE video in murattal.",
    "style": "murattal",
    "max_seconds": 90,
    "always": [
      1
    ]
  },
  "schedule": {
    "timezone": "Asia/Baghdad",
    "posts_per_day": 2,
    "times": [
      "10:00",
      "20:00"
    ],
    "_note": "10:00 = next part of the sequential khatma; 20:00 (prime time) = a well-known / comforting passage from the featured list.",
    "slots": {
      "10:00": "khatma",
      "20:00": "featured"
    }
  },
  "caption": {
    "khatma_template": "سورة {surah} | {range} 🤍\nختمة القرآن كاملة بصوت {reciter} — الحلقة {episode}\n\nتابع الحساب حتى نكمل الختمة سوا 🤍 وشاركها صدقة جارية لك ولوالديك 🤲\n\n{hashtags}",
    "featured_template": "{hook} 🤍\n{place} — بصوت {reciter}\n\nاكتب «سبحان الله» 🤍 وشاركها لعلها تكون صدقة جارية لك ولوالديك 🤲\n\n{hashtags}",
    "hashtag_sets": [
      [
        "#قرآن",
        "#تلاوة_خاشعة",
        "#المنشاوي",
        "#راحة_نفسية",
        "#العراق"
      ],
      [
        "#القران_الكريم",
        "#تلاوة",
        "#صدقه_جاريه",
        "#quran",
        "#العراق"
      ],
      [
        "#قران_كريم",
        "#راحة_القلب",
        "#المنشاوي",
        "#اكسبلور",
        "#العراق"
      ]
    ],
    "surah_hashtag_prefix": "#سورة_",
    "_note": "Khatma clips carry an episode number (series -> follows). Featured clips lead with a short hook. Hashtag sets rotate so captions stay unique when the featured list repeats."
  },
