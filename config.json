{
  "reciter": {
    "name_ar": "الشيخ محمد صديق المنشاوي",
    "recitations": {
      "mujawwad": {
        "id": 8,
        "style_ar": "مجوّد"
      },
      "murattal": {
        "id": 9,
        "style_ar": "مرتّل"
      }
    },
    "default_style": "murattal"
  },
  "clip": {
    "min_seconds": 30,
    "max_seconds": 60,
    "prepend_basmala": true
  },
  "short_surahs": {
    "_note": "Al-Fatiha and any surah whose whole murattal recitation fits in max_seconds are posted as ONE video in murattal.",
    "style": "murattal",
    "max_seconds": 90,
    "always": [
      1
    ]
  },
  "schedule": {
    "timezone": "Asia/Baghdad",
    "posts_per_day": 5,
    "times": [
      "10:00",
      "12:00",
      "16:00",
      "18:00",
      "20:00"
    ]
  },
  "caption": {
    "hashtags": [
      "#العراق",
      "#صدقه_جاريه",
      "#القران_الكريم"
    ],
    "surah_hashtag_prefix": "#سورة_",
    "template": "سورة {surah} | {range} 🤍\nبصوت {reciter} ({style})\n\nشاركها لعلها تكون صدقة جارية لك ولوالديك 🤲\n\n{hashtags}"
  },
  "backgrounds": {
    "library_size": 40,
    "queries": [
      "waterfall",
      "mountains clouds",
      "ocean waves",
      "forest fog",
      "sunset sky",
      "river stream",
      "desert dunes",
      "snowy mountains",
      "lake reflection",
      "clouds timelapse",
      "rain leaves",
      "night sky stars",
      "green hills",
      "autumn forest"
    ],
